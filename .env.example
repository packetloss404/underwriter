# Copy to .env and fill in. NEVER commit .env.
# .env is gitignored; keep real keys out of the repository and out of the dashboard.

# --- Alpaca paper credentials ---
# Development paper account. Keep the brand-new competition account separate
# and do not put its credentials here until the judged run.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca CLI: paper is the DEFAULT. Live trading requires ALPACA_LIVE_TRADE=true.
# This project must never set that. It is listed here only to document the
# variable that the preflight explicitly asserts is unset/false.
ALPACA_LIVE_TRADE=false

# Alpaca MCP server uses a separate variable and defaults to paper.
ALPACA_PAPER_TRADE=true

# CLI output format and profile (optional)
ALPACA_OUTPUT=json
ALPACA_PROFILE=

# --- AI catalyst veto ---
# Set ONE of these. The veto sits behind a single interface, so every provider
# gets identical failure handling: a timeout, a refusal or unreadable JSON is a
# veto whichever one is wired. The model can only stop a trade, never cause one.
#
# Anthropic and OpenAI are wired direct, each through its own vendor endpoint.
# The four below speak the OpenAI wire format and differ only by a base URL,
# which is why they cost a table row rather than a client.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
FEATHERLESS_API_KEY=

# auto | anthropic | openai | deepseek | openrouter | minimax | featherless
# "auto" takes the first key present in exactly that order and never falls back
# to a second one, so which model screened a trade is reproducible from this
# file alone. Naming a provider whose key is unset is an error, not a fallback.
UNDERWRITER_MODEL_PROVIDER=auto

# Override the model name; defaults track the provider:
#   anthropic   claude-sonnet-5
#   openai      gpt-4o
#   deepseek    deepseek-v4-pro
#   openrouter  ~openai/gpt-latest
#   minimax     MiniMax-M3
#   featherless Qwen/Qwen2.5-7B-Instruct
UNDERWRITER_MODEL=

# Escape hatch for an OpenAI-compatible endpoint with no row in the table: a
# self-hosted server, a proxy, a vendor added after this was written. Leave
# blank to use the provider's own URL. Refused with anthropic, which cannot
# honour it -- better a startup error than a setting that silently does nothing.
UNDERWRITER_MODEL_BASE_URL=

# --- Runtime ---
UNDERWRITER_ENV=dev
UNDERWRITER_KILL_SWITCH=false
