# Copy to .env and fill in. NEVER commit .env.
# .env is gitignored; keep real keys out of the repository and out of the dashboard.

# --- Alpaca paper credentials ---
# Development paper account. Keep the brand-new competition account separate
# and do not put its credentials here until the judged run.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca CLI: paper is the DEFAULT. Live trading requires ALPACA_LIVE_TRADE=true.
# This project must never set that. It is listed here only to document the
# variable that the preflight explicitly asserts is unset/false.
ALPACA_LIVE_TRADE=false

# Alpaca MCP server uses a separate variable and defaults to paper.
ALPACA_PAPER_TRADE=true

# CLI output format and profile (optional)
ALPACA_OUTPUT=json
ALPACA_PROFILE=

# --- AI catalyst veto ---
# Either provider works; the veto sits behind one interface. With both set,
# "auto" prefers Anthropic so a stray second key cannot silently change which
# model screens the trades.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# auto | anthropic | openai
UNDERWRITER_MODEL_PROVIDER=auto
# Override the model name; defaults track the provider.
UNDERWRITER_MODEL=

# --- Runtime ---
UNDERWRITER_ENV=dev
UNDERWRITER_KILL_SWITCH=false
