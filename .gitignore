# Secrets — never commit credentials or account identifiers
.env
.env.*
!.env.example
*.pem
*.key
secrets/
config/local*.toml

# Runtime state
*.db
*.db-journal
*.sqlite
*.sqlite3
data/
journal/
artifacts/
logs/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/

# .python-version IS tracked. The Railway builder detects uv but defaults to
# Python 3.13.2, and this file is the only thing pinning the 3.12 we test on.
# Ignoring it would silently deploy on an interpreter nothing here has run.

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
